# Railway sets PORT automatically
PORT=8080

# PostgreSQL connection string (Railway provides this as DATABASE_URL)
DATABASE_URL=postgres://user:pass@host:5432/tinyme?sslmode=disable

# API key for protecting management endpoints (leave empty for dev)
API_KEY=

# Public base URL
BASE_URL=http://localhost:8080

# Default redirect domain
REDIRECT_BASE=tinyme.cc
